# 9/11: script-src — kun appens egne scripts + de tre kendte værter (supabase/heic: jsdelivr · jszip: cdnjs · chat: crisp). 'unsafe-inline'/'unsafe-eval' er nødvendige, fordi appen har onclick i HTML og new Function; målt i browser uden ét brud.
# SIKKERHED (sikkerhedschefen løfte 21, 10/10): kun https, og appen kan kun vises i en ramme på energida.dk selv (klik-kapring)
/*
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: frame-ancestors 'self' https://energida.dk https://*.energida.dk; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://client.crisp.chat; object-src 'none'; base-uri 'self'

# HTML skal altid revalideres — mobiler må aldrig hænge fast i en gammel version
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
# Versionsfilen maa ALDRIG cachelagres — det var praecis dét, der fik vagten til at loope 25/8
/version.txt
  Cache-Control: no-store, max-age=0
# Haster-filen (30/10): Ida sender en rettelse ud med det samme — maa heller aldrig cachelagres
/haster.txt
  Cache-Control: no-store, max-age=0
